{
  "name": "motoboy-tracker",
  "version": "2.0.0",
  "private": true,
  "description": "ZipRotas · Painel da loja: veja onde cada motoboy está em tempo real",
  "type": "commonjs",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "vite build",
    "start": "node server.js",
    "start:real": "node -e \"process.env.SIMULATE='0';require('./server.js')\"",
    "build:demo": "vite build --mode demo",
    "artifact": "vite build --mode demo && node scripts/make-artifact.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "animejs": "4.5",
    "leaflet": "^1.9.4",
    "three": "^0.187.0",
    "vue": "3.5",
    "vue-router": "4.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.11",
    "vite": "^8.3.8"
  }
}
